<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EffectlessLuaGen | Manifest Hub</title>
    <!-- Tailwind CSS for modern styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #0b0b0e; color: #e2e2e2; }
        .panel { background-color: #15151a; border: 1px solid #23232a; }
        .accent-bg { background-color: #5865F2; } /* Discord Blurple / Theme Purple */
        .accent-hover:hover { background-color: #4752c4; }
        /* Hide scrollbars for clean look */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-thumb { background: #2a2a35; border-radius: 4px; }
    </style>
</head>
<body class="h-screen flex flex-col font-sans overflow-hidden">

    <!-- LOGIN SCREEN -->
    <div id="loginScreen" class="flex items-center justify-center h-full w-full absolute z-50 bg-[#0b0b0e]">
        <div class="panel p-8 rounded-xl shadow-2xl text-center max-w-md w-full">
            <h1 class="text-3xl font-bold mb-2 text-white">EffectlessLuaGen</h1>
            <p class="text-gray-400 mb-8">Secure Manifest & Lua Database</p>
            <a href="YOUR_GENERATED_DISCORD_URL_HERE" class="accent-bg accent-hover text-white px-6 py-3 rounded-lg font-semibold w-full block transition-colors">
                <i class="fa-brands fa-discord mr-2"></i> Login with Discord
            </a>
        </div>
    </div>

    <!-- MAIN APP (Hidden until logged in) -->
    <div id="mainHub" class="hidden h-full flex flex-col">
        
        <!-- Top Navbar -->
        <nav class="panel border-b border-gray-800 px-6 py-4 flex justify-between items-center z-10">
            <div class="flex items-center space-x-4">
                <h1 class="text-xl font-bold text-white tracking-wide">EffectlessLuaGen</h1>
            </div>
            <div class="flex items-center space-x-4 text-sm font-medium">
                <div class="flex items-center space-x-2 bg-[#1a1a24] px-4 py-2 rounded-full border border-gray-700">
                    <img id="userAvatar" src="https://cdn.discordapp.com/embed/avatars/0.png" class="w-6 h-6 rounded-full" alt="Avatar">
                    <span id="welcomeMessage" class="text-gray-300">Loading...</span>
                </div>
            </div>
        </nav>

        <!-- Main Content Area -->
        <div class="flex flex-1 overflow-hidden p-6 gap-6">
            
            <!-- Left/Center Column: Search & Results -->
            <div class="flex-1 flex flex-col gap-6 overflow-y-auto pr-2">
                
                <!-- Search Bar Area -->
                <div class="panel rounded-xl p-6 shadow-lg">
                    <div class="flex items-center gap-4">
                        <div class="relative flex-1">
                            <i class="fa-solid fa-search absolute left-4 top-3.5 text-gray-500"></i>
                            <input type="text" id="searchInput" placeholder="Enter App ID to search games..." 
                                class="w-full bg-[#0b0b0e] border border-gray-700 text-white text-sm rounded-lg focus:ring-purple-500 focus:border-purple-500 block pl-10 p-3 transition-colors">
                        </div>
                        <button onclick="searchGame()" class="accent-bg accent-hover text-white px-6 py-3 rounded-lg font-semibold transition-colors">
                            Search
                        </button>
                    </div>
                </div>

                <!-- Game Result Card -->
                <div id="gameCard" class="panel rounded-xl p-0 overflow-hidden shadow-lg hidden">
                    <div class="relative h-64 w-full bg-gray-900">
                        <img id="gameImage" src="" class="w-full h-full object-cover opacity-80" alt="Game Banner">
                        <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-[#15151a] to-transparent h-32"></div>
                    </div>
                    
                    <div class="p-6 relative -mt-12">
                        <h2 id="gameTitle" class="text-3xl font-bold text-white mb-1">Game Title</h2>
                        <p class="text-purple-400 font-mono text-sm mb-6">AppID: <span id="gameId"></span></p>
                        
                        <div class="panel bg-[#0b0b0e] p-4 rounded-lg flex items-center justify-between border-gray-800">
                            <div class="flex items-center gap-3">
                                <i class="fa-solid fa-file-zipper text-2xl text-gray-400"></i>
                                <div>
                                    <p class="text-white font-medium text-sm">Manifest Archive</p>
                                    <p class="text-gray-500 text-xs">Contains necessary .lua and manifest files</p>
                                </div>
                            </div>
                            <a id="downloadBtn" href="#" target="_blank" class="accent-bg accent-hover text-white px-5 py-2.5 rounded-md text-sm font-semibold transition-colors flex items-center gap-2">
                                <i class="fa-solid fa-download"></i> Download ZIP
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Sidebar: Top Games -->
            <div class="w-80 flex flex-col gap-6 hidden lg:flex">
                <div class="panel rounded-xl p-5">
                    <h3 class="text-white font-bold mb-4 flex items-center gap-2"><i class="fa-solid fa-fire text-orange-500"></i> Top Requests</h3>
                    <div class="space-y-3">
                        <!-- Dummy Top Game 1 -->
                        <div class="flex gap-3 items-center bg-[#0b0b0e] p-2 rounded-lg cursor-pointer hover:bg-gray-800" onclick="document.getElementById('searchInput').value='1091500'; searchGame();">
                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/1091500/capsule_sm_120.jpg" class="w-16 h-8 object-cover rounded">
                            <div>
                                <p class="text-xs font-bold text-gray-200">Cyberpunk 2077</p>
                                <p class="text-[10px] text-gray-500">1091500</p>
                            </div>
                        </div>
                        <!-- Dummy Top Game 2 -->
                        <div class="flex gap-3 items-center bg-[#0b0b0e] p-2 rounded-lg cursor-pointer hover:bg-gray-800" onclick="document.getElementById('searchInput').value='1888930'; searchGame();">
                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/1888930/capsule_sm_120.jpg" class="w-16 h-8 object-cover rounded">
                            <div>
                                <p class="text-xs font-bold text-gray-200">The Last of Us Part I</p>
                                <p class="text-[10px] text-gray-500">1888930</p>
                            </div>
                        </div>
                        <!-- Dummy Top Game 3 -->
                        <div class="flex gap-3 items-center bg-[#0b0b0e] p-2 rounded-lg cursor-pointer hover:bg-gray-800" onclick="document.getElementById('searchInput').value='1245620'; searchGame();">
                            <img src="https://cdn.akamai.steamstatic.com/steam/apps/1245620/capsule_sm_120.jpg" class="w-16 h-8 object-cover rounded">
                            <div>
                                <p class="text-xs font-bold text-gray-200">Elden Ring</p>
                                <p class="text-[10px] text-gray-500">1245620</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <script>
        // Authentication Logic
        window.onload = () => {
            const fragment = new URLSearchParams(window.location.hash.slice(1));
            const accessToken = fragment.get('access_token');

            if (accessToken) {
                document.getElementById('loginScreen').style.display = 'none';
                document.getElementById('mainHub').classList.remove('hidden');

                // Get Discord User Info
                fetch('https://discord.com/api/users/@me', {
                    headers: { authorization: `Bearer ${accessToken}` }
                })
                .then(result => result.json())
                .then(response => {
                    document.getElementById('welcomeMessage').innerText = response.username;
                    if(response.avatar) {
                        document.getElementById('userAvatar').src = `https://cdn.discordapp.com/avatars/${response.id}/${response.avatar}.png`;
                    }
                });
            }
        };

        // Search Logic
        async function searchGame() {
            const appId = document.getElementById('searchInput').value.trim();
            if(!appId) return;
            
            const btn = document.querySelector('button');
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

            try {
                const res = await fetch(`https://steamspy.com/api.php?request=appdetails&appid=${appId}`);
                const data = await res.json();
                
                if (data.name) {
                    document.getElementById('gameTitle').innerText = data.name;
                    document.getElementById('gameId').innerText = appId;
                    document.getElementById('gameImage').src = `https://cdn.akamai.steamstatic.com/steam/apps/${appId}/header.jpg`;
                    document.getElementById('downloadBtn').href = `https://raw.githubusercontent.com/Aayuuush4Real/lua-bot/main/${appId}.zip`;
                    document.getElementById('gameCard').classList.remove('hidden');
                } else {
                    alert("Game not found on Steam!");
                }
            } catch (err) {
                alert("Error connecting to database.");
            }
            
            btn.innerHTML = 'Search';
        }

        // Allow pressing Enter to search
        document.getElementById("searchInput").addEventListener("keypress", function(event) {
            if (event.key === "Enter") {
                event.preventDefault();
                searchGame();
            }
        });
    </script>
</body>
</html>
